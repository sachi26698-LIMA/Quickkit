# QUICKKIT environment template — copy to `.env.local` only if needed.
# The site runs with no environment variables. Nothing here is a secret and
# nothing is required for `npm run dev`, `npm test` or `npm run build`.

# Public production origin used for canonical URLs, Open Graph URLs and the
# sitemap. Must be an HTTPS origin with no path or credentials, e.g.
# SITE_URL=https://quickkit.example
# Leave unset until the owner has verified the real domain.
SITE_URL=

# Second, explicit launch gate. Indexing is enabled only when SITE_URL is set
# to a verified HTTPS origin AND this flag is true in the production
# environment. Vercel Preview/Development stay noindex regardless.
LAUNCH_APPROVED=false

# Optional: silence Next.js build telemetry locally.
# NEXT_TELEMETRY_DISABLED=1

# VERCEL_ENV and VERCEL_URL are supplied by Vercel at build time.
# Never commit a real `.env*` file; only this example is tracked.
