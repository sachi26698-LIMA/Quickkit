# Set only to an owner-verified HTTPS origin; never a guessed domain.
# SITE_URL=https://your-verified-domain.example
# Leave false until domain, legal, privacy, security and deployment checks are approved.
LAUNCH_APPROVED=false
# VERCEL_ENV and VERCEL_URL are supplied by Vercel; do not copy production overrides into previews.

# Word to PDF engine selection. Read docs/WORD_TO_PDF_V5_SETUP.md.
#   auto        (default) worker -> libreoffice -> builtin renderer
#   builtin     bundled DOCX renderer, no external binaries
#   libreoffice requires soffice on this host; fails closed if missing
#   worker      requires WORD_TO_PDF_WORKER_URL + TOKEN; fails closed otherwise
# WORD_TO_PDF_ENGINE=auto
# The bundled renderer works without any of the variables below.
# WORD_TO_PDF_ENABLED=false
# WORD_TO_PDF_SOFFICE=/usr/bin/libreoffice

# V4 preferred production topology: private authenticated container-per-job broker.
# Under WORD_TO_PDF_ENGINE=auto an unhealthy worker falls through to libreoffice or
# builtin; WORD_TO_PDF_ENGINE=worker fails closed instead of falling back.
# Read docs/WORD_TO_PDF_V4_SETUP.md; this environment cannot build/validate the image.
# WORD_TO_PDF_WORKER_URL=https://your-private-worker-host.example/
# WORD_TO_PDF_WORKER_TOKEN=<32-128 random URL-safe characters; never expose to browser>
# Loopback-only HTTP is accepted for same-host private transport; all other URLs require HTTPS.
