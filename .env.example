# Set only to an owner-verified HTTPS origin; never a guessed domain.
# Current production origin: https://www.quickkit.live (the apex quickkit.live
# 301-redirects here). This one variable drives every canonical URL, Open Graph
# / Twitter URL, JSON-LD @id, the sitemap and the robots.txt Sitemap line.
# Nothing else may hard-code a production origin.
# SITE_URL=https://www.quickkit.live
# Leave false until domain, legal, privacy, security and deployment checks are approved.
LAUNCH_APPROVED=false
# Ads are off by default. Both switches must be explicitly true after separate approval.
# ADS_ENABLED=true
# NEXT_PUBLIC_ADS_ENABLED=true
# VERCEL_ENV and VERCEL_URL are supplied by Vercel; do not copy production overrides into previews.

# Supabase is used only for authorized administrator authentication and private submissions.
# Visitors do not have signup, login, profiles, or cloud favorites; browser tools work anonymously.
# QUICKKIT_ADMIN_EMAILS is a server-only comma/semicolon-separated allowlist of admin emails.
# Obtain the exact Project URL and public anon/publishable key from Supabase Settings > API.
# NEXT_PUBLIC_SUPABASE_URL=<project-url-from-supabase-dashboard>
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<public-anon-or-publishable-key>
# QUICKKIT_ADMIN_EMAILS=<allowlisted-admin-email-list>
# Server-only elevated key; NEVER prefix with NEXT_PUBLIC_ or expose to browser code.
# SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-or-secret-key>
# Server-only 32+ byte random HMAC key; generate locally with: openssl rand -base64 32
# Used for submission protection and domain-separated administrator recovery proof.
# SUPABASE_SUBMISSION_HMAC_SECRET=<server-only-random-secret>
# Recovery in preview requires ONE owner-approved HTTPS origin, configured only
# in that isolated preview. Its exact /auth/recovery URL must also be allowlisted
# by the isolated Supabase project. Never use production credentials for testing.
# QUICKKIT_RECOVERY_PREVIEW_ORIGIN=https://approved-preview.example
# Development accepts only an explicitly configured loopback origin and port.
# QUICKKIT_RECOVERY_LOCAL_ORIGIN=http://localhost:3001
# Recovery requires the service-role limiter and proof-consumption RPCs.
# Vercel ingress must supply its trusted x-vercel-forwarded-for header; missing
# infrastructure fails closed. Local development uses one shared IP bucket.

# Word to PDF engine selection. Read docs/WORD_TO_PDF_V5_SETUP.md.
#   auto        (default) worker -> libreoffice -> builtin renderer
#   builtin     bundled DOCX renderer, no external binaries
#   libreoffice requires soffice on this host; fails closed if missing
#   worker      requires WORD_TO_PDF_WORKER_URL + TOKEN; fails closed otherwise
# WORD_TO_PDF_ENGINE=auto
# The bundled renderer works without any of the variables below.
# WORD_TO_PDF_ENABLED=false
# WORD_TO_PDF_SOFFICE=/usr/bin/libreoffice

# V4 preferred production topology: private authenticated container-per-job broker.
# Under WORD_TO_PDF_ENGINE=auto an unhealthy worker falls through to libreoffice or
# builtin; WORD_TO_PDF_ENGINE=worker fails closed instead of falling back.
# Read docs/WORD_TO_PDF_V4_SETUP.md; this environment cannot build/validate the image.
# WORD_TO_PDF_WORKER_URL=https://your-private-worker-host.example/
# WORD_TO_PDF_WORKER_TOKEN=<32-128 random URL-safe characters; never expose to browser>
# Loopback-only HTTP is accepted for same-host private transport; all other URLs require HTTPS.

# Optional first-party visitor statistics (opt-in per browser).
# With the Supabase server credentials above and migration 202611160003 applied, the
# counter is stored in that Supabase project and needs nothing else.
# Optional alternative: a persistent libSQL/Turso database. When set, it is used instead.
# Never prefix the token with NEXT_PUBLIC_. Without any database the graph shows unavailable.
# ANALYTICS_DATABASE_URL=libsql://your-provisioned-database.turso.io
# ANALYTICS_DATABASE_TOKEN=your-server-only-token
# Self-hosted single-host alternative: file:/absolute/persistent-volume/visitor-stats.db
# Local file databases are explicitly rejected on Vercel (ephemeral filesystem).

# Optional opt-in error monitoring (strictly OFF / "Not configured" by default).
# When true, scrubbed error events (error type, message, route; never tool input, files,
# cookies or IP addresses) are stored in the Supabase project for 30 days. Requires
# migration 202611160003. Enable only after the privacy text has been reviewed.
# ERROR_MONITORING_ENABLED=false
# Optional external provider DSN. No external adapter ships with the app; leave unset.
# ERROR_MONITORING_DSN=https://public-key@o0.ingest.sentry.io/0

# Day (YYYY-MM-DD) the owner last confirmed custom SMTP in Supabase Auth settings.
# The app cannot read SMTP settings; this only records that confirmation for the
# Admin health panel. Not a secret. Leave unset if it has not been checked.
# AUTH_SMTP_VERIFIED_ON=2026-11-16

