{
  "name": "quickkit",
  "version": "1.0.0",
  "scripts": {
    "prepare:pdfjs": "node scripts/copy-pdfjs-assets.mjs",
    "prepare:qpdf": "node scripts/copy-qpdf-assets.mjs",
    "prepare:html-minifier": "node scripts/copy-html-minifier-wasm.mjs",
    "predev": "npm run prepare:pdfjs && npm run prepare:ocr && npm run prepare:qpdf && npm run prepare:html-minifier",
    "dev": "next dev --hostname 0.0.0.0",
    "prebuild": "npm run prepare:pdfjs && npm run prepare:ocr && npm run prepare:qpdf && npm run prepare:html-minifier",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.tsx\" \"lib/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"workers/**/*.ts\" \"scripts/**/*.mjs\" \"*config.{ts,mjs}\" package.json tsconfig.json",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.tsx\" \"lib/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"workers/**/*.ts\" \"scripts/**/*.mjs\" \"*config.{ts,mjs}\" package.json tsconfig.json",
    "prepare:ocr": "node scripts/copy-ocr-assets.mjs",
    "fixture:word-to-pdf": "node scripts/word-to-pdf-v5-fixture.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Privacy-conscious browser tools. Handy utilities. Zero hassle.",
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@neslinesli93/qpdf-wasm": "0.3.1",
    "@tesseract.js-data/ben": "1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/guj": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "@tesseract.js-data/mar": "1.0.0",
    "@tesseract.js-data/tam": "1.0.0",
    "@tesseract.js-data/tel": "1.0.0",
    "@tesseract.js-data/urd": "1.0.0",
    "@xmldom/xmldom": "^0.9.12",
    "@zxing/library": "^0.23.0",
    "csso": "^5.0.5",
    "docx": "^9.15.1",
    "docx-preview": "^0.4.1",
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.66.0",
    "minify-html-wasm": "^0.1.1",
    "next": "^16.4.3",
    "pdfjs-dist": "6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terser": "^5.51.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/csso": "^5.0.5",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "jpeg-js": "^0.4.4",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12",
    "zxing-wasm": "^3.1.6"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    }
  }
}
